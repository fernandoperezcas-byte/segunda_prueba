# Etapa 1: Constructor (Instala Poetry y descarga dependencias)
FROM python:3.12-slim AS builder

WORKDIR /app

# Instalar Poetry garantizando la compatibilidad con tu versión
RUN pip install --no-cache-dir "poetry>=2.0.0"

# Copiar solo los archivos de configuración de dependencias
COPY pyproject.toml poetry.lock* ./

# Configurar Poetry para que no cree un entorno virtual separado (instala directo en el sistema)
RUN poetry config virtualenvs.create false \
    && poetry install --no-root --only main

# Etapa 2: Imagen Final de Producción (Ultra ligera)
FROM python:3.12-slim

WORKDIR /app

# Copiar las librerías instaladas desde la etapa anterior
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copiar el código fuente completo del proyecto respetando la estructura raíz
COPY src/ ./src

# Exponer el puerto nativo de FastAPI
EXPOSE 8000

# Comando para arrancar la API con Uvicorn
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
